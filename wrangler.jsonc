{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "alusora-flowers",
	"main": "./src/index.js",
	"compatibility_date": "2026-11-02",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "alusora-flowers-db",
			"database_id": "01656796-9813-46fb-b638-fe2ed43438aa",
			"migrations_dir": "./migrations"
		},
		{
			"binding": "alusora_flowers_db",
			"database_name": "alusora-flowers-db",
			"database_id": "01656796-9813-46fb-b638-fe2ed43438aa",
			"remote": true
		}
	],
	"vars": {
		"CONTACT_EMAIL": "alicia.arron@gmail.com",
		"FROM_EMAIL": "ALUSORA Flowers <alicia.arron@gmail.com>",
		"TURNSTILE_SITE_KEY": ""
	}
}